{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "icon": "assets/${mod_id}/icon.png",
  "description": "Client rendering and shared biome sampling optimizations: caching, vertex encoding, model batching, lighting and terrain face culling. Ready to play, with optional Mod Menu settings.",
  "authors": [
    "theremila"
  ],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "entrypoints": {
    "client": ["${mod_package}.CirrusClient"],
    "server": ["${mod_package}.CirrusServer"],
    "modmenu": ["${mod_package}.integration.CirrusModMenu"]
  },
  "suggests": {"modmenu": "*"},
  "breaks": {"${previous_mod_id}": "*", "${legacy_mod_id}": "*"},
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "mixinextras": ">=0.5.0"
  }
}
